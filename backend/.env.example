# Ambiente: development | production
ENV=development

# Banco de dados
# Dev local (SQLite, via aiosqlite):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Producao (Postgres/Neon, via asyncpg) - exemplo:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# JWT
JWT_SECRET=troque-esta-chave-por-uma-string-aleatoria-longa
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Token usado pelo job diario (POST /jobs/run-daily), header X-Job-Token
JOB_SECRET_TOKEN=troque-este-token-tambem

# Web Push (VAPID) - gere com: vapid --gen (pacote py-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=seu-email@exemplo.com

# CORS - origem do frontend
FRONTEND_ORIGIN=http://localhost:4200
